<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Standalone magnetometer (HMC5883L / QMC5883L USB stick). Mounted
       as far as practical from the BTS7960s and the battery to reduce
       magnetic interference. The rover_compass package reads heading
       from its serial port and publishes /imu/data + /imu/mag. -->

  <xacro:macro name="compass_mount" params="x y z">
    <link name="compass_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.005"/>
        </geometry>
        <material name="yellow"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.005"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.0001" iyz="0.0"
                 izz="0.0001"/>
      </inertial>
    </link>

    <joint name="compass_joint" type="fixed">
      <parent link="base_link"/>
      <child link="compass_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
