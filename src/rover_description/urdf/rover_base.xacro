<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Chassis dimensions -->
  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width"  value="0.22"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass"   value="5.0"/>

  <!-- Wheel/track values mirrored in:
         - ESP32 firmware: firmware/include/config.h
         - rover_hardware/config/diff_drive_params.yaml
       Keep them in sync. -->
  <xacro:property name="wheel_radius" value="0.032"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.2"/>
  <xacro:property name="wheel_base"   value="0.150"/>

  <xacro:macro name="rover_base" params="">
    <link name="base_link">
      <visual>
        <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
        <mass value="${chassis_mass}"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0"
                 iyy="0.1" iyz="0.0"
                 izz="0.1"/>
      </inertial>
    </link>
  </xacro:macro>

</robot>
